LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=your-api-key-here
LLM_MODEL=deepseek-chat
# 技能通道（百炼 Managed Agents Skill API）复用上面那把 LLM_API_KEY，不需要第二把 key；
# 但需要业务空间 ID —— 它在主机名里，控制台右上角下拉菜单可看，形如 llm-xxxxxxxxxxxx
BAILIAN_WORKSPACE_ID=your-workspace-id
# 可选，目前百炼只有 cn-beijing 一个取值
BAILIAN_REGION=cn-beijing
